# ==============================
# C++ Language & Toolchain
# ==============================
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wconversion

# Link libibverbs so symbols bind to IBVERBS_1.1, not legacy IBVERBS_1.0
build --linkopt=-libverbs

# Bypass ccache read-only sandbox issues
build --repo_env=CC=/usr/bin/gcc
build --repo_env=CXX=/usr/bin/g++
build --action_env=CC=/usr/bin/gcc
build --action_env=CXX=/usr/bin/g++

# ==============================
# Dependency & Bzlmod Settings
# ==============================
# Enable Bzlmod dependency management
build --enable_bzlmod

# Enforce strict lockfile behavior
build --lockfile_mode=update

# Bypass header dependency checks
# build --noinclude_checking

# For easier readability
build --color=yes

# ==============================
# Performance & Execution
# ==============================
# Sandboxing for hermetic builds
build --spawn_strategy=sandboxed

# Disk cache sharing across workspaces
# `~/.cache/bazel` breaks Bazel 9.0+
build --disk_cache=~/.cache/bazel_

# ==============================
# Debug & Troubleshooting
# ==============================
# For release: --config=opt
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG

# For debug: --config=dbg
build:dbg --compilation_mode=dbg
build:dbg --copt=-g
build:dbg --copt=-O0

# AddressSanitizer: --config=asan
build:asan --copt=-fsanitize=address
build:asan --linkopt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
