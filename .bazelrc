# ==========================================
# C++ Toolchain & Language Configuration
# ==========================================
# Set default C++ standard to C++20
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Pass compiler flags to surface relevant warnings
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wconversion

# Set host compiler explicitly to bypass ccache read-only sandbox issues on Fedora
build --repo_env=CC=/usr/bin/gcc
build --repo_env=CXX=/usr/bin/g++
build --action_env=CC=/usr/bin/gcc
build --action_env=CXX=/usr/bin/g++

# ==========================================
# Dependency & Bzlmod Settings
# ==========================================
# Enable Bzlmod dependency management (default in Bazel 7+)
build --enable_bzlmod

# Enforce strict lockfile behavior in CI environments, update locally
# (Pass --lockfile_mode=error via CI scripts instead if preferred)
build --lockfile_mode=update

# Bypass header dependency checks for legacy/third-party BUILD rules if needed
# build --noinclude_checking

# ==========================================
# Performance & Execution
# ==========================================
# Enable strict sandboxing for hermetic and reproducible builds
build --spawn_strategy=sandboxed

# Disk cache sharing across workspace builds (stored outside sandbox)
build --disk_cache=~/.cache/bazel_disk_cache

# Enable colorful output for easier readability
build --color=yes

# ==========================================
# Debug & Troubleshooting Configurations
# ==========================================
# Standard Debug Build (Usage: bazel build --config=dbg //...)
build:dbg --compilation_mode=dbg
build:dbg --copt=-g
build:dbg --copt=-O0

# Optimized Release Build (Usage: bazel build --config=opt //...)
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG

# AddressSanitizer Configuration (Usage: bazel build --config=asan //...)
build:asan --copt=-fsanitize=address
build:asan --linkopt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
